
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#050914">
<title>عـلـي TV | Rudaw TV</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  background: #050914;
  color: #fff;
  font-family: Arial, sans-serif;
}

header {
  padding: 22px 12px;
  text-align: center;
  background: linear-gradient(135deg, #142b45, #050914);
  border-bottom: 1px solid #16435c;
}

.logo {
  color: #35e5ff;
  font-size: 32px;
  font-weight: 900;
  text-shadow: 0 0 18px #008cff80;
}

.subtitle {
  color: #bdcad8;
  font-size: 13px;
  margin-top: 8px;
}

.live {
  display: inline-block;
  margin-top: 13px;
  padding: 7px 15px;
  color: #ff6678;
  background: #24111b;
  border: 1px solid #67263a;
  border-radius: 30px;
  font-size: 12px;
}

main {
  width: 100%;
  max-width: 950px;
  margin: auto;
  padding: 15px 10px;
}

h2 {
  font-size: 17px;
  margin: 5px 0 14px;
}

.player {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #000;
  overflow: hidden;
  border: 1px solid #16435c;
  border-radius: 12px;
}

video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #000;
}

.status {
  margin-top: 10px;
  text-align: center;
  color: #35e5ff;
  font-size: 13px;
}

.buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  justify-content: center;
  margin-top: 15px;
}

button {
  padding: 12px 16px;
  color: white;
  background: #10253a;
  border: 1px solid #1e607c;
  border-radius: 10px;
  font-size: 13px;
  font-weight: bold;
}

button.primary {
  background: linear-gradient(135deg, #00c8df, #0877d1);
  color: #00121b;
}

.info {
  margin-top: 16px;
  padding: 15px;
  background: #0d1726;
  border: 1px solid #1b344b;
  border-radius: 12px;
  color: #b9c9da;
  font-size: 13px;
  line-height: 1.9;
}

.info strong {
  color: #35e5ff;
}

footer {
  text-align: center;
  padding: 22px 10px;
  color: #778ba0;
  font-size: 12px;
}

body.fullscreen-page header,
body.fullscreen-page h2,
body.fullscreen-page .buttons,
body.fullscreen-page .info,
body.fullscreen-page footer,
body.fullscreen-page .status {
  display: none;
}

body.fullscreen-page main {
  max-width: none;
  padding: 0;
}

body.fullscreen-page .player {
  width: 100%;
  height: 100dvh;
  aspect-ratio: auto;
  border: 0;
  border-radius: 0;
}

@media (max-width: 480px) {
  .logo { font-size: 28px; }
  main { padding: 12px 7px; }
  button { padding: 11px 12px; }
}
</style>
</head>

<body>
<header>
  <div class="logo">عـلـي TV</div>
  <div class="subtitle">عالم المشاهدة في مكان واحد</div>
  <div class="live">🔴 Rudaw TV مباشر</div>
</header>

<main>
  <h2>📺 قناة رووداو الفضائية</h2>

  <div class="player" id="player">
    <video id="video"
      controls
      playsinline
      webkit-playsinline
      preload="none">
    </video>
  </div>

  <div class="status" id="status">جارٍ تجهيز البث...</div>

  <div class="buttons">
    <button class="primary" onclick="goFullscreen()">
      ⛶ ملء الشاشة
    </button>
    <button onclick="reloadPlayer()">
      ↻ إعادة تحميل
    </button>
    <button onclick="toggleInterface()">
      ◉ إخفاء / إظهار الواجهة
    </button>
  </div>

  <div class="info">
    <strong>أهلاً وسهلاً بكم في عـلـي TV 🤩</strong>
    <p>
      لمشاهدة قناة رووداو، اضغط زر التشغيل داخل الفيديو.
      يعتمد التشغيل على توفر البث والسماح بتشغيله داخل الموقع.
    </p>
  </div>
</main>

<footer>© 2026 عـلـي TV</footer>

<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
<script>
const STREAM_URL =
  "https://live.rudaw.net/hls/rudaw-tv/master.m3u8";

const video = document.getElementById("video");
const statusBox = document.getElementById("status");
let hls = null;

function setStatus(message) {
  statusBox.textContent = message;
}

function loadStream() {
  if (hls) {
    hls.destroy();
    hls = null;
  }

  video.pause();
  video.removeAttribute("src");
  video.load();

  setStatus("جارٍ الاتصال بقناة رووداو...");

  if (window.Hls && Hls.isSupported()) {
    hls = new Hls({
      enableWorker: true,
      lowLatencyMode: true
    });

    hls.loadSource(STREAM_URL);
    hls.attachMedia(video);

    hls.on(Hls.Events.MANIFEST_PARSED, function() {
      setStatus("تم تجهيز البث — اضغط تشغيل");
    });

    hls.on(Hls.Events.ERROR, function(event, data) {
      if (!data.fatal) return;

      if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
        setStatus("تعذر تحميل البث. تحقق من الرابط أو اتصال الإنترنت.");
      } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
        setStatus("حدث خطأ في الفيديو، جارٍ محاولة الإصلاح...");
        hls.recoverMediaError();
      } else {
        setStatus("تعذر تشغيل المصدر داخل المشغّل.");
        hls.destroy();
        hls = null;
      }
    });

  } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
    video.src = STREAM_URL;

    video.addEventListener("loadedmetadata", function() {
      setStatus("تم تجهيز البث — اضغط تشغيل");
    }, { once: true });

    video.addEventListener("error", function() {
      setStatus("تعذر التشغيل. قد يكون المصدر يمنع التشغيل المباشر.");
    }, { once: true });

  } else {
    setStatus("هذا المتصفح لا يدعم تشغيل HLS.");
  }
}

function reloadPlayer() {
  loadStream();
}

function goFullscreen() {
  const player = document.getElementById("player");

  if (player.requestFullscreen) {
    player.requestFullscreen().catch(() => {
      document.body.classList.add("fullscreen-page");
    });
  } else if (video.webkitEnterFullscreen) {
    video.webkitEnterFullscreen();
  } else {
    document.body.classList.add("fullscreen-page");
  }
}

function toggleInterface() {
  document.body.classList.toggle("fullscreen-page");
}

document.addEventListener("fullscreenchange", function() {
  if (!document.fullscreenElement) {
    document.body.classList.remove("fullscreen-page");
  }
});

loadStream();
</script>
</body>
</html>
